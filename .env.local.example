# Supabase (server key is server-only: never prefix it with NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic: REQUIRED for AI-powered document analysis
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Stripe: one-time payments only (no subscriptions).
# Use TEST values locally / on staging / on Vercel Preview. LIVE values belong ONLY
# in the Vercel Production environment, and live keys are refused unless
# STRIPE_ALLOW_LIVE=true is also set there.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs differ between Stripe test and live mode; create one of each per mode.
STRIPE_PRICE_ID_SINGLE=price_...   # $49 one-time, USD: single-year audit
STRIPE_PRICE_ID_MULTI=price_...    # $149 one-time, USD: multi-year audit (up to 5 years)
# Public site origin used for Checkout return URLs (defaults to https://leaseguard.io)
APP_BASE_URL=http://localhost:3000   # production: https://www.leaseguard.io (the site serves on www)
# STRIPE_ALLOW_LIVE=true            # Production only, when live payments are approved
